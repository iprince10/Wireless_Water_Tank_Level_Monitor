{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "RX firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PICO_SDK_PATH": "$penv{USERPROFILE}/.pico-sdk/sdk/2.3.1",
        "PATH": "$penv{USERPROFILE}/.pico-sdk/ninja/v1.13.2;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
